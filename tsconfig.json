{
  // Type-CHECK only — never a build step. `node server.js` still runs the .js
  // files directly and untouched; tsc runs as a linter (`npm run typecheck`,
  // wired into `npm test` so a type error blocks the Render deploy like a red
  // test does). We emit nothing (noEmit) and compile nothing.
  //
  // The @ts-nocheck ratchet is fully paid off: every backend file below is
  // genuinely checked — there are no opt-out pragmas left, and a new file is
  // checked from day one, under full `strict`. Keep it that way: no @ts-nocheck,
  // and no blanket `{any}` to get past noImplicitAny.
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,

    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],

    // Full `strict`, noImplicitAny included. A catch binding is `unknown`: read it
    // through lib/errors.js (errorMessage / errorCode / errorStack), not `err.message`.
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  // scripts/** is included alongside the server: it was outside BOTH this list and
  // the ESLint scope until 2026-08-01, so the build/CI tooling — including
  // collect-esm-frontend.js, which defines the lint and type-check scopes — was
  // neither linted nor type-checked.
  "include": ["server.js", "instrument.js", "load-env.js", "lib/**/*.js", "routes/**/*.js", "scripts/**/*.js", "lib/types/**/*.d.ts"],
  "exclude": ["node_modules"]
}
