# Dependencies (npm-only: CI and Render run `npm ci`)
node_modules/
npm-debug.log*
pnpm-lock.yaml
pnpm-workspace.yaml
yarn.lock

# Secrets: real values live in .env, template in .env.example
.env
.env.*
!.env.example

# Runtime state (SQLite, CSV logs) and the Litestream binary fetched at build.
# Anchored: unanchored `bin/` would swallow instagram/bin/.
/data/
/bin/

# Scratch and logs
*.log
*.tmp
/tmp/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Playwright artifacts
test-results/
playwright-report/
blob-report/
.playwright/

# Noto font masters (~40 MB), downloaded on demand by build-disclosure-badges.js
to-build/disclosure-badges/fonts/
# design-sync bundle, regenerable
ds-bundle/
# scripts/eval-staging.js default output
eval-out/

# Instagram per-run files (real posts are committed)
instagram/posts/_scratch/
instagram/posts/_work/

# Local-only tooling output
.claude/
previews/*
!previews/README.md
prototypes/
